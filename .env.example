# =============================================================================
# DATA
# =============================================================================

DATA_PATH=data/raw/data.parquet
SCHEMA_PATH=data/schema/schema.json
OUTPUT_DIR=output


# =============================================================================
# MODEL
# =============================================================================

# Feature representation:
# indices | embeddings | both
FEATURE_SET=indices

# Models used in the first instance-MIR experiment
MODELS=RIDGE_REGRESSION,ELASTIC_NET,SVR,RANDOM_FOREST,EXTRA_TREES,XGBOOST

RANDOM_STATE=42

# PCA is applied only to embeddings.
# Use "none" to disable PCA.
PCA_COMPONENTS=50


# =============================================================================
# NESTED GROUPED CROSS-VALIDATION
# =============================================================================

# Outer folds estimate generalization to unseen physical Points.
OUTER_SPLITS=5

# Inner folds are used by Optuna for hyperparameter selection.
INNER_SPLITS=4


# =============================================================================
# OPTUNA
# =============================================================================

# Number of optimization trials performed for each model
# inside each outer fold.
OPTUNA_TRIALS=30


# =============================================================================
# INSTANCE-MIR INFERENCE
# =============================================================================

# Fixed number of 1-minute recordings randomly sampled
# per CapturePointId when comparing models.
INFERENCE_K=10

# Number of repeated random samples used to obtain a
# more stable instance-MIR validation score.
INFERENCE_REPEATS=20


# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
DEBUG=false