# =============================================================================
# DATA
# =============================================================================

# Path to the input dataset.
DATA_PATH=data/raw/data.parquet

# Path to the JSON schema describing target, grouping variables and features.
SCHEMA_PATH=data/schema/schema.json

# Base directory where experiment outputs will be saved.
OUTPUT_DIR=output


# =============================================================================
# FEATURES
# =============================================================================

# Feature representation used by the model.
#
# Options:
# indices     -> acoustic indices only
# embeddings  -> embeddings only
# both        -> acoustic indices + embeddings
FEATURE_SET=indices

# Number of PCA components retained for acoustic indices.
#
# The index representation contains:
# mean + within-day std + between-day std
#
# Used when:
# FEATURE_SET=indices
# FEATURE_SET=both
#
# PCA is fitted only on the training fold.
# Use None to disable PCA for indices.
PCA_INDICES_COMPONENTS=30

# Number of PCA components retained for embeddings.
#
# The embedding representation contains:
# mean + within-day std + between-day std
#
# Used when:
# FEATURE_SET=embeddings
# FEATURE_SET=both
#
# PCA is fitted only on the training fold.
# Use None to disable PCA for embeddings.
PCA_EMBEDDINGS_COMPONENTS=30


# =============================================================================
# MODELS
# =============================================================================

# Regression models evaluated in the experiment.
#
# Available models:
# RIDGE_REGRESSION
# ELASTIC_NET
# SVR
# RANDOM_FOREST
# EXTRA_TREES
# XGBOOST
#
# Use:
# MODELS=all
# to evaluate every available model.
MODELS=RIDGE_REGRESSION,ELASTIC_NET,SVR,RANDOM_FOREST,EXTRA_TREES,XGBOOST

# Global random seed used for reproducibility.
RANDOM_STATE=42


# =============================================================================
# NESTED CROSS-VALIDATION
# =============================================================================

# Number of outer GroupKFold splits.
#
# The outer CV estimates generalization to unseen Points.
OUTER_SPLITS=5

# Number of inner GroupKFold splits.
#
# The inner CV is used by Optuna for hyperparameter selection.
INNER_SPLITS=4

# Number of Optuna trials performed for each model
# inside each outer training fold.
OPTUNA_TRIALS=20


# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
DEBUG=false