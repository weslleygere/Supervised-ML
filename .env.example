# =============================================================================
# DATA
# =============================================================================

# Path to the input dataset.
DATA_PATH=data/raw/data.parquet

# Path to the JSON schema describing target, grouping variables and features.
SCHEMA_PATH=data/schema/schema.json

# Base directory where experiment outputs will be saved.
OUTPUT_DIR=output


# =============================================================================
# TEMPORAL CURATION
# =============================================================================

MIN_CAPTURE_DAYS=7
MAX_CAPTURE_WINDOW_DAYS=28


# =============================================================================
# PIPELINE SEARCH SPACE
# =============================================================================

# Feature representations considered during pipeline optimization.
#
# Options:
# indices
# embeddings
# both
FEATURE_SETS=indices,embeddings,both


# Acoustic aggregation strategies considered during pipeline optimization.
#
# mean
#     equal-day mean acoustic state
#
# mean_std
#     mean acoustic state
#     + total temporal variability
#
# hierarchical
#     mean acoustic state
#     + within-day variability
#     + between-day variability
#
# robust_daily
#     median daily acoustic state
#     + within-day IQR
#     + between-day IQR
#
# dawn_profile
#     equal-day acoustic means in four 30-minute intervals
#     between 04:00 and 06:00
#
# dawn_trend
#     mean acoustic level at 05:00
#     + mean dawn slope
#     + between-day slope variability
AGGREGATION_STRATEGIES=mean,mean_std,hierarchical,robust_daily,dawn_profile,dawn_trend


# Dimensionality-reduction / feature-selection strategies considered
# during pipeline optimization.
#
# none
#     use all standardized features
#
# pca
#     weighted PCA fitted only on the training fold
#
# supervised_selection
#     weighted target-correlation feature selection fitted only
#     on the training fold
REDUCTION_METHODS=none,pca,supervised_selection


# Candidate PCA dimensions for the acoustic-index block.
PCA_INDICES_CANDIDATES=2,4,6,8,10,12,16,20,24,32,40

# Candidate PCA dimensions for the embedding block.
PCA_EMBEDDINGS_CANDIDATES=2,4,6,8,10,12,16,20,24,32,40


# Candidate numbers of acoustic-index features retained by
# supervised feature selection.
SELECTION_INDICES_CANDIDATES=2,4,6,8,10,12,16,20,24,32,40

# Candidate numbers of embedding dimensions retained by
# supervised feature selection.
SELECTION_EMBEDDINGS_CANDIDATES=2,4,6,8,10,12,16,20,24,32,40


# =============================================================================
# MODELS
# =============================================================================

# Available model families:
#
# RIDGE_REGRESSION
# ELASTIC_NET
# BAYESIAN_RIDGE
#
# SVR
# KERNEL_RIDGE
#
# RANDOM_FOREST
# EXTRA_TREES
#
# GRADIENT_BOOSTING
# XGBOOST
# LIGHTGBM
# CATBOOST
#
# Use:
#
# MODELS=all
#
# to expose every model family to the same CASH search.
MODELS=all


# Global random seed.
RANDOM_STATE=42


# =============================================================================
# DEVELOPMENT / FINAL TEST SPLIT
# =============================================================================

# Fraction of independent Points reserved for the final test set.
TEST_SIZE=0.20

# Number of Point-level HFI quantile strata used by the holdout split.
HFI_STRATA=4


# =============================================================================
# REPEATED GROUPED CROSS-VALIDATION
# =============================================================================

# Number of grouped cross-validation folds used to score each candidate
# pipeline on the development set.
CV_SPLITS=5

# Number of independent repetitions of grouped CV.
CV_REPEATS=5


# =============================================================================
# OPTUNA
# =============================================================================

# Number of complete pipeline candidates evaluated by Optuna.
OPTUNA_TRIALS=400