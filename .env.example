# Each family gets OPTUNA_TRIALS configuration + hyperparameter trials.
RUN_MODE=nested_selection
DATA_PATH=data/raw/data.parquet
SCHEMA_PATH=data/schema/schema.json
OUTPUT_DIR=output_experiments
SOURCE_RUN=
RESUME_RUN=

# All agreed model families; or provide comma-separated enum names (see README).
MODELS=all
FEATURE_SETS=indices,embeddings,both
AGGREGATION_STRATEGIES=mean,mean_std,hierarchical
REDUCTION_METHODS=none,pca
PCA_COMPONENT_CANDIDATES=5,10,20,40,60
PCA_VARIANCE_CANDIDATES=0.90,0.95,0.99
FEATURE_SCALINGS=standard

# One Audio_Name mean = one operational sample. Sample validation/test ONLY.
# Train on ALL available recordings, one signature per CapturePointId.
# Sampling is uniform over available Audio_Name samples, without day quotas.
SELECTION_EFFORTS=1,5,10,15,25,50
SELECTION_SAMPLING_REPEATS=10

OUTER_SPLITS=5
OUTER_REPEATS=3
INNER_SPLITS=4
OPTUNA_TRIALS=60
SPLIT_SEED=42
SAMPLING_SEED=1042
SEARCH_SEED=2042
MODEL_SEED=3042
MODEL_JOBS=1
CACHE_ENTRIES=8

# Used only by RUN_MODE=effort_analysis. SOURCE_RUN supplies the frozen protocol.
# Counts must not exceed the source run's largest selection effort.
EFFORT_ANALYSIS_COUNTS=1,2,3,4,5,10,15,20,25,30,40,50
EFFORT_ANALYSIS_REPEATS=50
BOOTSTRAP_REPEATS=1000
CONFIDENCE_LEVEL=0.95
# 0 disables plateau declaration. Choose a meaningful HFI threshold beforehand.
PLATEAU_TOLERANCE=0
PLATEAU_WINDOW=3
LOG_LEVEL=INFO
