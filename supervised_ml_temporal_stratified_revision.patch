+import pandas as pd
+import pytest
+
+from src.core.data.schema import Schema
+from src.core.data.temporal_curation import TemporalCurator
+
+
+@pytest.fixture
+def schema() -> Schema:
+    return Schema(
+        target="meanHFI",
+        group="Point",
+        bag="CapturePointId",
+        audio="Audio_Name",
+        datetime="AudioDate",
+        index_prefixes=("s_", "t_"),
+        embedding="embedding",
+    )
+
+
+def _capture_rows(
+    point: str,
+    bag: str,
+    start: str,
+    day_offsets: list[int],
+) -> list[dict]:
+
+    rows = []
+
+    for offset in day_offsets:
+        datetime = (
+            pd.Timestamp(
+                start
+            )
+            + pd.Timedelta(
+                days=offset,
+                hours=4,
+            )
+        )
+
+        rows.append(
+            {
+                "Point": point,
+                "CapturePointId": bag,
+                "Date": datetime.date(),
+                "Audio_Name": f"{bag}_{offset}",
+                "AudioDate": datetime,
+                "meanHFI": float(
+                    point.removeprefix("P")
+                ),
+            }
+        )
+
+    return rows
+
+
+def test_minimum_days_is_applied_per_capturepoint(
+    schema: Schema,
+) -> None:
+
+    audio = pd.DataFrame(
+        _capture_rows(
+            "P1",
+            "C_short",
+            "2026-01-01",
+            list(
+                range(
+                    6
+                )
+            ),
+        )
+        + _capture_rows(
+            "P1",
+            "C_valid",
+            "2026-01-01",
+            list(
+                range(
+                    7
+                )
+            ),
+        )
+    )
+
+    curated, manifest = TemporalCurator(
+        schema=schema,
+        min_observed_days=7,
+        max_window_days=28,
+    ).curate(
+        audio
+    )
+
+    assert set(
+        curated[
+            "CapturePointId"
+        ]
+    ) == {
+        "C_valid",
+    }
+
+    status = (
+        manifest.set_index(
+            "CapturePointId"
+        )[
+            "status"
+        ]
+        .to_dict()
+    )
