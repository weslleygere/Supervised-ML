# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# =============================================================================
# DATA PATHS
# =============================================================================

# Path to the main dataset file
DATA_PATH=data/raw/data.csv

# Path to the schema definition file (JSON format)
SCHEMA_PATH=data/schema/schema.json

# Base directory for experiment outputs
OUTPUT_DIR=output

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Models to include in the evaluation pipeline
# Options:
#   - 'all': Include all available models
#   - 'MODEL1,MODEL2,MODEL3': Include only specified models
# Available models: LINEAR_REGRESSION, RIDGE_REGRESSION, LASSO_REGRESSION, 
# ELASTIC_NET, PLS, K_NEIGHBORS, DECISION_TREE, RANDOM_FOREST, EXTRA_TREES, 
# ADABOOST, XGBOOST, LIGHTGBM, CATBOOST, SVR, MLP
MODELS=all

# Random seed for reproducible results
RANDOM_STATE=42

# =============================================================================
# CROSS-VALIDATION
# =============================================================================

# Number of folds for cross-validation
N_SPLITS=5

# =============================================================================
# LOGGING
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable debug mode
DEBUG=false
